#version 450
#extension GL_GOOGLE_include_directive : enable

#define IS_REFRACTION_GLSL
#include "global.h"

#define M_PI 3.1415926535897932384626433832795

// 64 bytes
layout(push_constant) uniform Transform {
	mat4 mvp;
};

layout(set = VK_DESC_UNIFORM, binding = VK_DESC_UNIFORM_MAIN_BINDING) uniform UBO {
	// light/env/material parameters:
	vec4 eyePos;
	vec4 lightPos;
	vec4 lightColor;
	vec4 lightVector;
	
#if !defined(USE_VBO_GHOUL2) && !defined(USE_VBO_MDV)
	// refraction parameters:
	vktcMod_t u_tcMod;
	vktcGen_t u_tcGen;
#endif
};

layout(set = VK_DESC_UNIFORM, binding = VK_DESC_UNIFORM_CAMERA_BINDING) uniform Camera {
	vec4 u_ViewOrigin;
};

layout(set = VK_DESC_UNIFORM, binding = VK_DESC_UNIFORM_ENTITY_BINDING) uniform Entity {
	vkUniformEntity_t u_entity;
};

layout(set = VK_DESC_UNIFORM, binding = VK_DESC_UNIFORM_GLOBAL_BINDING) uniform Global {
	vkUniformGlobal_t u_global;
};

#if defined(USE_VBO_GHOUL2)
layout(set = VK_DESC_UNIFORM, binding = VK_DESC_UNIFORM_BONES_BINDING) uniform Bones {
	vkUniformBones_t u_bones;
};

layout(location = 10) in uvec4 in_bones;
layout(location = 11) in vec4 in_weights;
#endif

layout(location = 0) in vec3 in_position;
#if !defined(USE_VBO_GHOUL2) && !defined(USE_VBO_MDV)
	layout(location = 1) in vec4 in_color;
#endif
layout(location = 2) in vec2 in_tex_coord0;
layout(location = 5) in vec3 in_normal;

layout(location = 0) out vec4 frag_color;
layout(location = 1) out vec4 var_RefractPosR;
layout(location = 2) out vec4 var_RefractPosG;
layout(location = 3) out vec4 var_RefractPosB;
// Where this fragment would have sampled with no refraction at all: the edge
// fade in the fragment shader slides back to it rather than clamping, and a
// clamp would smear one edge pixel across the whole surface.
layout(location = 4) out vec4 var_ScreenPos;
layout(location = 5) out vec2 var_TexCoord;

out gl_PerVertex {
	vec4 gl_Position;
};

// Glass, near enough. The channels are split around this by the chromatic
// parameter rather than by three fixed constants, so that the split can be
// turned off - three hard-coded indices cannot be.
const float ETA_BASE = 1.0 / 1.20;

#define SHADER_VERT
#include "common/utils.glsl"
#include "common/deform.glsl"
#include "common/color.glsl"
#include "common/skinning.glsl"

void main() {

#if defined(USE_VBO_MDV)
	vec3 position = in_position;
	vec3 normal = normalize(in_normal);
	//vec3 normal = normalize(in_normal - vec3(0.5));

	if ( u_global.deform.type != 0 ){ // !DEFORM_NONE
		position	= DeformPosition( position, normal, in_tex_coord0 );
		normal		= DeformNormal( position, normal );
	}
#elif defined(USE_VBO_GHOUL2)
	mat4x3 skin_matrix =
		GetBoneMatrix(in_bones.x) * in_weights.x +
        GetBoneMatrix(in_bones.y) * in_weights.y +
        GetBoneMatrix(in_bones.z) * in_weights.z +
        GetBoneMatrix(in_bones.w) * in_weights.w;

	vec3 position = skin_matrix * vec4(in_position, 1.0);
	vec3 normal = normalize(skin_matrix * vec4(in_normal, 0.0));
	//vec3 normal = normalize(skin_matrix * vec4(in_normal - vec3(0.5), 0.0));

	if ( u_global.deform.type != 0 ){ // !DEFORM_NONE
		position	= DeformPosition( position, normal, in_tex_coord0 );
		normal		= DeformNormal( position, normal );
	}
#else
	vec3 position = in_position;
	vec3 normal = in_normal;
	//vec3 normal = in_normal * 2.0 - vec3(1.0);
#endif

	gl_Position = mvp * vec4(position, 1.0);

	#if defined(USE_VBO_GHOUL2) || defined(USE_VBO_MDV)
		frag_color = CalcColor( 0, position, normal );

		vec2 tex			= GenTexCoords( in_tex_coord0.st, u_global.bundle[0].tcGen.type, position, normal, u_global.bundle[0].tcGen.vector0, u_global.bundle[0].tcGen.vector1 );
		vec2 var_DiffuseTex = ModTexCoords( tex, position, u_global.bundle[0].tcMod.matrix, u_global.bundle[0].tcMod.offTurb );

	#else
		frag_color = in_color;

		vec2 tex			= GenTexCoords( in_tex_coord0.st, u_tcGen.type, position, normal, u_tcGen.vector0, u_tcGen.vector1 );
		vec2 var_DiffuseTex = ModTexCoords( tex, position, u_tcMod.matrix, u_tcMod.offTurb );
	#endif

	//
	// Screen-space refraction.
	//
	// Everything below stays in the space mvp expects - object space for an
	// entity, world space for the world - because the entity uniform already
	// carries the camera into that space. The previous version went out to world
	// space and back through an inverse of the model matrix per vertex, and built
	// its view direction out of three vectors that were all zero, so the offset
	// came out along the normal and did not depend on where the camera was.
	//
	vec3 viewDir	= normalize( position - u_entity.localViewOrigin.xyz );
	vec3 N			= normalize( normal );

	// How far along the refracted ray the exit point sits. This is the surface's
	// apparent thickness, and it is what decides how strong the effect looks.
	float thickness	= u_global.refraction.x;

	// Chromatic aberration: the three channels bend by slightly different
	// amounts. Zero puts them back on top of each other.
	float chroma	= u_global.refraction.w;

	vec3 exitR = position + refract( viewDir, N, ETA_BASE * ( 1.0 - chroma ) ) * thickness;
	vec3 exitG = position + refract( viewDir, N, ETA_BASE                    ) * thickness;
	vec3 exitB = position + refract( viewDir, N, ETA_BASE * ( 1.0 + chroma ) ) * thickness;

	var_RefractPosR = mvp * vec4( exitR, 1.0 );
	var_RefractPosG = mvp * vec4( exitG, 1.0 );
	var_RefractPosB = mvp * vec4( exitB, 1.0 );

	var_ScreenPos = gl_Position;
	var_TexCoord = var_DiffuseTex;

	// How much of the refracted image reaches the screen is a property of the
	// surface, not of the pixel, so it rides in on the vertex colour and the
	// fragment shader needs no uniform of its own for it.
	frag_color.a *= u_global.refraction.y;
}