#version 450
#extension GL_GOOGLE_include_directive : enable

// Water: a surface normal that is computed rather than sampled.
//
// What the old path draws is one flat colour with the texture coordinates
// wobbled, and no amount of wobbling a flat colour produces a highlight. The
// thing an eye actually reads water by is the SPECULAR response - a thousand
// small facets catching the light at slightly different angles - and that is a
// question about the normal, not about the texture. So there is no texture here
// at all: the normal comes from two travelling wave fields summed together, and
// everything else follows from it.
//
// Deliberately procedural rather than two scrolling normal maps, which is the
// usual recipe. A map has a resolution and therefore a distance at which it
// turns to mush and a distance at which it tiles visibly; a function has
// neither, and it costs no memory and no asset. The cost is that it is a sum of
// sines and looks like one if you use too few octaves.
#define IS_LIQUID_GLSL
#include "global.h"

layout(set = VK_DESC_UNIFORM, binding = VK_DESC_UNIFORM_GLOBAL_BINDING) uniform Global {
	vkUniformGlobal_t u_global;
};

// The material's own base texture, and it is not optional.
//
// The body colour of the liquid has to come from somewhere, and the first
// version took it from rgbGen alone. That works on a fixture whose material is a
// constant colour and fails on every retail map in the game: retail water is a
// TEXTURE and carries no rgbGen at all, so the water would have come out white.
// The two are multiplied, which is what the ordinary path does with the same
// two things.
layout(set = VK_DESC_TEXTURE0, binding = 0) uniform sampler2D texture0;

// The depth of everything that was drawn before the transparent surfaces, as a
// texture. Soft particles built this; the body of a liquid reads exactly the
// same thing for a different reason - how far the light has travelled through
// it before coming back out, which is what decides both the colour of the body
// and where the shore is.
layout(set = VK_DESC_UNIFORM, binding = VK_DESC_UNIFORM_SCENE_DEPTH_BINDING) uniform sampler2D scene_depth_texture;

layout(location = 0) in vec4 frag_color;
layout(location = 1) in vec3 var_WorldPos;
layout(location = 2) in vec3 var_Normal;
layout(location = 3) in vec3 var_ViewDir;
layout(location = 4) in vec4 var_ScreenPos;
layout(location = 5) in vec2 var_TexCoord;

layout(location = 0) out vec4 out_color;

// One travelling wave: a sine along a direction, and its slope.
//
// The slope is what is wanted, not the height. A displacement this shader
// cannot apply - the geometry is four vertices and the vertex shader cannot add
// more - but the NORMAL of the surface it would have made is exactly what the
// lighting reads, and that is available in closed form. This is why the water
// looks like it has waves while its silhouette stays flat, and why the silhouette
// is the one thing this cannot fix.
vec2 WaveSlope( vec2 pos, vec2 dir, float wavelength, float speed, float time, float amplitude )
{
	float k = 6.2831853 / wavelength;
	float phase = dot( pos, dir ) * k + time * speed * k;

	// d/dpos of ( amplitude * sin( phase ) ), which is the gradient of the
	// height field along dir.
	return dir * ( amplitude * k * cos( phase ) );
}

void main()
{
	float time      = u_global.liquid.x;
	float wavelength = u_global.liquid.y;
	float speed     = u_global.liquid.z;
	float strength  = u_global.liquid.w;

	vec3  N = normalize( var_Normal );
	vec3  V = normalize( var_ViewDir );

	// Four layers at unrelated angles and shrinking wavelengths. Unrelated
	// matters: two directions that are a simple fraction of a turn apart build a
	// visible lattice, and the eye finds a lattice in water immediately.
	vec2 p = var_WorldPos.xy;
	vec2 slope = vec2( 0.0 );

	slope += WaveSlope( p, normalize( vec2(  1.00,  0.17 ) ), wavelength,         speed,        time, 1.00 );
	slope += WaveSlope( p, normalize( vec2( -0.31,  1.00 ) ), wavelength * 0.53,  speed * 1.31, time, 0.55 );
	slope += WaveSlope( p, normalize( vec2(  0.67, -0.74 ) ), wavelength * 0.27,  speed * 1.77, time, 0.28 );
	slope += WaveSlope( p, normalize( vec2( -0.88, -0.43 ) ), wavelength * 0.13,  speed * 2.19, time, 0.13 );

	// The slope is a gradient in the plane; the normal of a height field is
	// ( -dh/dx, -dh/dy, 1 ). Built against the surface's own normal so that this
	// is not silently a floor-only path - a water face is horizontal in every
	// map anyone has made, and code that assumes so stops working the first time
	// somebody tilts one.
	vec3 up      = N;
	vec3 tangent = normalize( abs( up.z ) < 0.99 ? cross( vec3( 0.0, 0.0, 1.0 ), up ) : vec3( 1.0, 0.0, 0.0 ) );
	vec3 bitangent = cross( up, tangent );

	vec3 Nw = normalize( up - ( tangent * slope.x + bitangent * slope.y ) * strength );

	// Fresnel. Looking straight down at water you see the bottom; looking along
	// it you see the sky, and the crossover is steep. Schlick, with the 0.02
	// that water actually has at normal incidence rather than a number chosen to
	// look right.
	float NV = clamp( dot( Nw, V ), 0.0, 1.0 );
	float fresnel = 0.02 + 0.98 * pow( 1.0 - NV, 5.0 );
	fresnel *= u_global.liquidSky.w;

	// The specular highlight, which is the whole point of having a normal.
	vec3  L = normalize( u_global.liquidLight.xyz );
	vec3  H = normalize( L + V );
	float NH = clamp( dot( Nw, H ), 0.0, 1.0 );
	float spec = pow( NH, max( u_global.liquidLight.w, 1.0 ) );

	// The material's own colour is what the water looks like when you look
	// straight into it, so the map author keeps control of that; the reflection
	// colour is what it becomes at a grazing angle.
	vec4 base = texture( texture0, var_TexCoord );
	vec3 deep = base.rgb * frag_color.rgb;
	vec3 sky  = u_global.liquidSky.rgb;

	// How deep the water is under this pixel, in the units the map is modelled
	// in: the distance to the bottom minus the distance to the surface, both
	// read out of the depth of the scene by inverting the projection.
	//
	// viewDepth.z says whether that texture holds THIS view yet - it is resolved
	// between the surfaces that write depth and the surfaces that only read it,
	// so a liquid whose material sorts as opaque is drawn before it exists. Zero
	// there means the two terms below stay switched off rather than reading the
	// frame before.
	float thickness = 0.0;

	if ( u_global.viewDepth.z > 0.5 && u_global.viewDepth.y != 0.0 ) {
		float b = u_global.viewDepth.x;
		float c = u_global.viewDepth.y;

		float bottomD = texelFetch( scene_depth_texture, ivec2( gl_FragCoord.xy ), 0 ).r;
		float bottomZ = c / ( bottomD + b );
		float surfaceZ = c / ( gl_FragCoord.z + b );

		// Along the view ray rather than straight down, which is what the two
		// distances actually measure. It is also the right quantity: a shallow
		// pool seen at a grazing angle IS more opaque, because the light has
		// further to go through it.
		thickness = max( bottomZ - surfaceZ, 0.0 );
	}

	// Absorption. Beer's law, one coefficient per channel, which is the whole
	// reason deep water is blue and a glass of it is not: red is absorbed first
	// and the light that survives the trip is what is left.
	vec3 absorb = exp( -thickness * u_global.liquidBody.rgb );

	// Transmitted plus inscattered, which is the shape the answer has whether or
	// not the transmitted half is any good. What survives the body is `deep` -
	// today the material's own colour, and the refracted image of what is behind
	// the surface once that lands - and what the body adds on its own account is
	// the colour it tends to with depth.
	vec3 body = deep * absorb + u_global.liquidDeep.rgb * ( 1.0 - absorb );

	// Foam at the shore. Where the body is thin, the surface meets something
	// solid, and that edge is the single most recognisable thing about the
	// outline of a body of water - without it the shore is a hard line drawn by
	// the depth test, which is the same defect soft particles fixed for smoke.
	float foam = 0.0;

	if ( u_global.liquidBody.w > 0.0 && u_global.viewDepth.z > 0.5 ) {
		foam = 1.0 - clamp( thickness / u_global.liquidBody.w, 0.0, 1.0 );

		// Squared, so the band hugs the edge instead of washing half the pool
		// out, and modulated by the waves so the line is not a clean offset
		// curve. The same slope that makes the highlight makes the froth ragged.
		// Against the surface's own normal rather than against world Z. Every
		// water face anyone has built is horizontal, and code that relies on
		// that stops working the first time somebody tilts one.
		foam = foam * foam * ( 0.75 + clamp( 1.0 - dot( Nw, N ), 0.0, 1.0 ) );
		foam = clamp( foam, 0.0, 1.0 );
	}

	out_color.rgb = mix( body, sky, fresnel ) + sky * spec;
	out_color.rgb = mix( out_color.rgb, u_global.liquidFoam.rgb, foam * u_global.liquidFoam.w );

	// More opaque where it reflects. A surface showing you the sky is not one
	// you can see the bottom through.
	// Opacity: what the material asked for, plus what the body absorbs, plus
	// what the reflection hides. Thin water at the shore is nearly clear, deep
	// water is not, and a surface showing you the sky is not one you can see the
	// bottom through.
	float alpha = base.a * frag_color.a;

	if ( u_global.viewDepth.z > 0.5 ) {
		float opaque = 1.0 - dot( absorb, vec3( 0.3333 ) );
		alpha = alpha + ( 1.0 - alpha ) * opaque;
	}

	alpha = alpha + ( 1.0 - alpha ) * fresnel;
	alpha = max( alpha, foam * u_global.liquidFoam.w );

	out_color.a = clamp( alpha, 0.0, 1.0 );
}
