// The menu has to be called mainMenu: that is the name the client asks for when
// it has nothing else to show, and if it is missing the client asks again every
// frame forever instead of settling into a frame loop.
{
menuDef
{
	name					"mainMenu"
	fullScreen				1
	rect					0 0 640 480
	visible					1

	// style and backcolor are not decoration. Without them the menu asks for a
	// background of zero alpha and the engine correctly draws nothing - which
	// looked for a while like the menu collapsing, and was really this file
	// leaning on the default shader to paint the screen for it.
	style					WINDOW_STYLE_FILLED
	backcolor				0.2 0.2 0.6 1

	// One picture, off-centre and not filling the screen, so that a frame which
	// drew nothing and a frame which drew this are different pictures.
	itemDef
	{
		name				smokebox
		rect				64 64 512 352
		background			"jkx/smoke"
		style				WINDOW_STYLE_FILLED
		backcolor			1 0.3 0.1 1
		forecolor			1 1 1 1
		visible				1
		decoration
	}
}
}
